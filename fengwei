<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>24 hours at Feng Wei</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 40px 20px;
      background: #f5f5f5;
      color: #111;
      font-family: Arial, Helvetica, sans-serif;
    }

    main {
      width: 100%;
      max-width: 680px;
      margin: 0 auto;
    }

    h1 {
      margin: 0 0 30px;
      font-size: 28px;
      font-weight: 500;
    }

    .track {
      display: grid;
      grid-template-columns: 42px 1fr;
      align-items: center;
      gap: 14px;
      padding: 14px 0;
      border-top: 1px solid #ccc;
    }

    .track:last-child { border-bottom: 1px solid #ccc; }
    .number { font-size: 14px; color: #555; }
    audio { display: block; width: 100%; height: 40px; }

    @media (max-width: 480px) {
      body { padding: 24px 16px; }
      .track { grid-template-columns: 30px 1fr; gap: 8px; }
    }
  </style>
</head>
